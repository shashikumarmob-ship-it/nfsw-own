# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# AI Provider: 'auto', 'pollinations', or 'huggingface'
AI_PROVIDER=auto

# Pollinations Model (openai-fast is 100% FREE without API key)
# Other models on Pollinations require POLLINATIONS_API_KEY
POLLINATIONS_MODEL=openai-fast

# Optional: Pollinations API Key from https://enter.pollinations.ai
POLLINATIONS_API_KEY=

# Optional: Hugging Face User Access Token from https://huggingface.co/settings/tokens
# (Enables high-performance serverless models: Llama-3.1, Qwen2.5, DeepSeek, etc.)
HF_TOKEN=

# Hugging Face Model ID (Used when HF_TOKEN is configured)
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Starting credits for new users
INITIAL_CREDITS=30

# Daily bonus credits
DAILY_BONUS=20

# Owner Telegram Chat/User ID (Gets ♾️ UNLIMITED credits & Owner badge)
# Multiple IDs can be separated by commas (e.g., 123456789 or 123456789,987654321)
OWNER_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Port for Render Web Service health-check
PORT=3000
